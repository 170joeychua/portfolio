    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.5",
    "@primeng/themes": "^21.0.4",
    "express": "^5.1.0",
    "gsap": "^3.14.2",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
