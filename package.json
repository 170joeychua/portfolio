{
  "name": "my-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:my-portfolio": "node dist/my-portfolio/server/server.mjs",
    "lint": "eslint .",
    "prepare": "husky install",
    "format": "prettier --write .",
    "fix": "eslint . --fix"
  },
  "private": true,
  "eslintIgnore": [
    ".angular/**",
    "dist/**",
    "node_modules/**"
  ],
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "21.2.6",
    "@angular/compiler": "21.2.6",
    "@angular/core": "21.2.6",
    "@angular/forms": "21.2.6",
    "@angular/platform-browser": "21.2.6",
    "@angular/platform-server": "21.2.6",
    "@angular/router": "21.2.6",
    "@angular/animations": "21.2.6",
    "@angular/ssr": "21.2.6",
    "@primeng/themes": "^21.0.4",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "gsap": "^3.14.2",
    "helmet": "^8.1.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.6",
    "@angular/cli": "21.2.6",
    "@angular/compiler-cli": "21.2.6",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/gsap": "^1.20.2",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^8.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html,scss}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
